# Copia este archivo a .env.local y llena los valores.
# La service_role key NUNCA va en el navegador: solo la usa el servidor.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cadena larga y aleatoria (32+ caracteres) para firmar las sesiones.
# Generar una: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
